{
  "$schema": "https://opencode.ai/config.json",
  "update": "disable",
  "model": "github-copilot/gpt-6-luna",
  "plugins": ["oh-my-opencode-slim@3.0.2"],
  "default_agent": "orchestrator",
  "permissions": [
    { "action": "skapa_*", "resource": "*", "effect": "allow" },
    { "action": "workflows_*", "resource": "*", "effect": "allow" }
  ],
  "mcp": {
    "servers": {
      "mise": {
        "type": "local",
        "command": ["bash", "-lc", "exec mise --cd \"$HOME/dotfiles\" mcp"],
        "environment": {
          "MISE_EXPERIMENTAL": "1"
        }
      },
      "skapa": {
        "type": "local",
        "command": ["bash", "-lc", "exec mise --cd \"$HOME/dotfiles\" -E private exec -- skapa-design-system-mcp"],
        "disabled": false
      },
      "workflows": {
        "type": "local",
        "command": ["bash", "-lc", "exec mise --cd \"$HOME/dotfiles\" -E private exec -- workflows-mcp"],
        "disabled": false
      }
    }
  },
  "lsp": true
}
