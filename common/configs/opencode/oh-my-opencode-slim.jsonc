{
  "$schema": "https://unpkg.com/oh-my-opencode-slim@3.0.2/oh-my-opencode-slim.schema.json",
  "preset": "copilot",
  "setDefaultAgent": true,

  "multiplexer": {
    "type": "auto",
    "layout": "main-vertical",
    "main_pane_size": 65
  },

  "presets": {
    "copilot": {
      "orchestrator": {
        "model": "github-copilot/gpt-6-luna",
        "variant": "high",
        "skills": [
          "oh-my-opencode-slim",
          "deepwork",
          "reflect",
          "worktrees",
          "source-control",
          "verification-planning",
          "omarchy"
        ],
        "mcps": ["gh_grep"]
      },
      "oracle": {
        "model": "github-copilot/gpt-6-sol",
        "variant": "max",
        "skills": ["simplify"],
        "mcps": []
      },
      "librarian": {
        "model": "github-copilot/gpt-6-luna",
        "variant": "medium",
        "skills": ["clonedeps"],
        "mcps": ["context7", "gh_grep"]
      },
      "explorer": {
        "model": "github-copilot/gpt-6-luna",
        "variant": "low",
        "skills": ["codemap"],
        "mcps": ["gh_grep"]
      },
      "designer": {
        "model": "github-copilot/gpt-6-luna",
        "variant": "high",
        "skills": ["agent-browser"],
        "mcps": []
      },
      "fixer": {
        "model": "github-copilot/gpt-6-luna",
        "variant": "high",
        "skills": [],
        "mcps": []
      }
    }
  }
}
